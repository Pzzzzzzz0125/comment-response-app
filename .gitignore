.DS_Store
__pycache__/
*.py[cod]

# Large/private original permit documents are supplied separately.
comments&response/
new/

# Regenerable converted document previews.
web_app/data/previews/

# Regenerable audit reports may contain workstation-local paths.
corpus_audit_output/

# Publish only the curated processed corpus needed to run the application.
# Backups, ingestion artifacts, telemetry, and local job state remain ignored.
phase2_dataset/*
!phase2_dataset/dataset.json
!phase2_dataset/evidence_model.json
# Workbook review reads these compact manifests at runtime. Keep the much
# larger extraction, OCR, Gemini, telemetry, and cache artifacts ignored.
!phase2_dataset/ingestion_artifacts/
phase2_dataset/ingestion_artifacts/*
!phase2_dataset/ingestion_artifacts/*/
phase2_dataset/ingestion_artifacts/*/*
!phase2_dataset/ingestion_artifacts/*/completeness_manifest.json
web_app/data/*.json
!web_app/data/category_assignments.json
!web_app/data/gemini_enrichment.json
!web_app/data/link_review_decisions.json
!web_app/data/search_index.json
!web_app/data/source_registry.json
!web_app/data/tag_suggestions.json
!web_app/data/workbook_review_decisions.json
web_app/data/retag_runs/
phase2/review_decisions.csv
corpus_audit/manual_overrides.csv

# Demo-derived runtime indexes are regenerated on first run.
demo_data/category_assignments.json
demo_data/gemini_enrichment.json
demo_data/search_index.json
demo_data/source_registry.json
demo_data/link_review_decisions.json
demo_data/previews/

# Local secrets and developer overrides.
.env
.env.*
!.env.example
PRIVATE_PROJECT_HANDOFF.md

# React frontend dependencies and local build diagnostics.
frontend/node_modules/
frontend/coverage/
frontend/dist/
frontend/*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Local delivery archives are generated from the authorized source corpus.
exports/
