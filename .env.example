# Permit Precedents local configuration
# Copy this file to .env.local. Never commit real API keys.

# Required for AI Chat, Smart Search, retagging, and verified ingestion.
# GOOGLE_API_KEY is accepted as an alias, so set only one of these.
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Required for Adobe PDF Embed. Create a localhost client ID for each developer.
ADOBE_PDF_EMBED_CLIENT_ID=

# Normal local server settings.
PERMIT_HOST=127.0.0.1
PERMIT_PORT=8010

# Split deployment: set this in the Vercel frontend project to the persistent
# backend origin. It is a public build-time URL, not a secret.
# VITE_API_BASE_URL=https://permit-api.example.com

# Split deployment: exact comma-separated frontend origins permitted by the
# Python backend. Do not use a wildcard for private permit data.
# PERMIT_ALLOWED_ORIGINS=https://permit.example.com,https://your-app.vercel.app

# Model routing. These defaults match the application defaults.
GEMINI_MODEL=gemini-3.5-flash
KNOWLEDGE_GEMINI_MODEL=gemini-3.6-flash
KNOWLEDGE_ROUTER_MODEL=gemini-3.1-flash-lite
INGESTION_GEMINI_MODEL=gemini-3.6-flash
PRESCAN_GEMINI_MODEL=gemini-3.1-flash-lite

# Ingestion concurrency and evidence-packet size. Lower workers if the API
# quota is small or the workstation has limited memory.
VISUAL_BATCH_WORKERS=2
FOLDER_INGESTION_WORKERS=2
VISUAL_BATCH_TEXT_CHARACTER_LIMIT=21500

# Optional executable overrides. They are most useful on Windows when the
# installers did not add these tools to PATH. Uncomment and adjust as needed.
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# GHOSTSCRIPT_PATH=C:\Program Files\gs\gs10.xx.x\bin\gswin64c.exe
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional private-data overrides. Defaults are repository-relative. Windows
# paths may use forward slashes (recommended) or escaped backslashes.
# PERMIT_DATASET_PATH=D:/permit-data/phase2_dataset/dataset.json
# PERMIT_CATEGORIES_PATH=D:/permit-data/web_app-data/category_assignments.json
# PERMIT_SOURCE_ROOT=D:/permit-data/source-files
# PERMIT_SOURCE_REGISTRY_PATH=D:/permit-data/web_app-data/source_registry.json
# PERMIT_PREVIEW_ROOT=D:/permit-data/web_app-data/previews
# PERMIT_ENRICHMENT_PATH=D:/permit-data/web_app-data/gemini_enrichment.json
# PERMIT_SEARCH_INDEX_PATH=D:/permit-data/web_app-data/search_index.json
# PERMIT_LINK_REVIEWS_PATH=D:/permit-data/web_app-data/link_review_decisions.json
# PERMIT_WORKBOOK_REVIEWS_PATH=D:/permit-data/web_app-data/workbook_review_decisions.json
# PERMIT_STATIC_ROOT=D:/comment-response-app/web_app/static

# Diagnostics and offline operation. Leave commented for normal use.
# PERMIT_DISABLE_GEMINI=true
# PERMIT_SEARCH_DEBUG=1
# PERMIT_SKIP_SOURCE_REGISTRY_MIGRATION=true
